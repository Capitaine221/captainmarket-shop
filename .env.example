# Local dev database (SQLite file). Not used in production once TURSO_DATABASE_URL is set.
DATABASE_URL="file:./dev.db"

# Turso (production database)
TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN=""

# Admin panel
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

# Stripe
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Public site URL (used for Stripe checkout redirect URLs)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Backup catalog site (separate Netlify deploy, see catalog-site/netlify.toml).
# Its Build Hook URL — set this and every product/category change auto-rebuilds it.
# Leave empty to disable (admin actions just skip the trigger silently).
CATALOG_BUILD_HOOK_URL=""
